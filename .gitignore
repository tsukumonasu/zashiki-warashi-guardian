# .kiro/ is intentionally NOT ignored — it must be committed.
# See the Kiroween submission rules.

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# ruff
.ruff_cache/

# ----- Node / TypeScript -----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ----- CDK -----
cloud/cdk.out/

# ----- macOS -----
.DS_Store
.AppleDouble

# ----- Editor -----
.vscode/
.idea/
*.swp
*.swo

# ----- Secrets and device-specific files -----
# Certificates, keys, and Wi-Fi credentials
*.pem
*.key
*.crt
*.p12
*.pfx
config.toml          # real device config — use config.example.toml as the template
*.env
.env.*
!.env.example

# Raspberry Pi bring-up artefacts
warashi_limits.txt
/device/tools/check_*.jpg
/device/tools/demo_*.jpg

# Audio generated locally
/device/warashi_agent/voice/*.wav
/device/warashi_agent/voice/*.mp3
# (lines.toml IS committed — only the generated audio files are excluded)

# Temporary snapshots
/tmp/
