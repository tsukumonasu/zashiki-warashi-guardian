# .kiro/ is intentionally NOT ignored: the Kiroween rules require it at the repository root.
# Note: gitignore has no trailing comments. A "#" after a pattern becomes part of the pattern.

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# ----- Node / TypeScript / CDK -----
node_modules/
dist/
*.tsbuildinfo
cdk.out/
cdk.context.json
cloud/node_modules/

# ----- OS and editors -----
.DS_Store
.idea/
*.swp

# ----- Secrets and device-specific files (never commit) -----
# Real device config. Commit config.example.toml instead.
config.toml
# Generated voice audio (rebuilt by scripts/generate_voice_lines.*).
device/warashi_agent/voice/*.wav
# Hash sidecar of scripts/generate_voice_lines.py (skips unchanged lines).
device/warashi_agent/voice/.voice-hashes.json
# Last head pose saved by the device at runtime.
last_pose.json
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# ----- Captures from the bring-up tools (may contain faces) -----
check_*.jpg
demo_*.jpg
warashi_limits.txt

# ----- Integration test measurements (latency harness output, may hold account details) -----
cloud/.integration-out/

# Listening-test audio of scripts/check_sonic_japanese.py.
.sonic-check-out/
